# Copy this file to .env before running the demo.

# Final release runtime profile
RAG_RELEASE_PROFILE_ONLY=true
RAG_DATA_PROFILE=cloud_primary_final
RAG_API_DATA_PROFILE=cloud_primary_final
RAG_API_RETRIEVAL_PROVIDER=local
RAG_LLM_EVIDENCE_TOP_K=5

# Persistent Python RAG service
RAG_SERVICE_HOST=127.0.0.1
RAG_SERVICE_PORT=31114
RAG_SERVICE_ENABLED=true
RAG_SERVICE_URL=http://127.0.0.1:31114
RAG_SERVICE_TIMEOUT_MS=90000

# 9Router / OpenAI-compatible endpoint.
# Do not commit your real API key.
9ROUTER_BASE_URL=http://localhost:20128/v1
9ROUTER_MODEL=chatx
9ROUTER_API_KEY=replace_me
9ROUTER_TEMPERATURE=0.1
9ROUTER_MAX_TOKENS=256
9ROUTER_TIMEOUT_MS=60000

# Express web server
PORT=3000

